{
  "name": "minicloud-control-plane",
  "version": "1.0.0",
  "private": true,
  "description": "A TypeScript control plane for managing Docker applications",
  "scripts": {
    "build": "tsc",
    "precontrol": "npm run build",
    "control": "node dist/index.js",
    "dev": "tsx watch src/server.ts",
    "preserver": "npm run build",
    "server": "node dist/server.js",
    "start": "npm run server",
    "premigrate": "npm run build",
    "migrate": "node dist/database/migrate.js",
    "test:persistence": "npm run build && node tests/persistence.cjs",
    "test:source": "npm run build && node tests/source-deployment.cjs",
    "test:projects": "npm run build && node --test tests/projects.cjs",
    "test:auto": "npm run build && node tests/auto-deployment.cjs"
  },
  "dependencies": {
    "dockerode": "^4.0.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.44",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
